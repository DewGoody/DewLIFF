PORT=8080
NODE_ENV=development

# Not actually used for querying at runtime (the app talks to Postgres only through
# the Supabase client below) — kept only because src/env.ts still declares it optionally.
DATABASE_URL=postgresql://user:pass@localhost:5432/dewliff_dev

# Supabase project this instance's data lives in. For local dev this can point at a
# local Supabase stack (`supabase start`) or a real dev-only Supabase project — the
# raw local Postgres created via supabase/migrations/*.sql is NOT queried directly by
# the app (see README).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LINE Messaging API channel + LINE Login channel (see docs/SYSTEM-OVERVIEW.md §8)
LINE_CHANNEL_ID=your-line-login-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

LIFF_URL=https://liff.line.me/your-liff-id
ALLOWED_ORIGINS=https://liff.line.me
LINE_API_BASE=https://api.line.me

# Optional. This deployment's own public base URL, used to build absolute URLs
# LINE's servers fetch (e.g. the OG-image hero card in src/services/match.ts).
# Leave unset on Vercel — it self-configures from VERCEL_PROJECT_PRODUCTION_URL /
# VERCEL_URL, which Vercel sets automatically. Only set this to override that
# (e.g. a custom domain). Never point this at KimLIFF's own deployment.
# APP_BASE_URL=https://your-dewliff-deployment.vercel.app

# LineKit integration (server-to-server write-back of quiz results).
# Leave blank until this LIFF is registered for real in LineKit's /liff-apps admin
# screen (see README "Connecting to LineKit"). Writes fail soft when unset.
LINEKIT_BASE_URL=http://localhost:3000
LINEKIT_LIFF_ID=
LINEKIT_API_KEY=
